__pycache__/
*.pyc
# v0.6.0 src 布局注:以下 zm_* 条目均为 basename 模式,移动文件后仍全部命中;
# 且 app_dir() 在开发模式锚定仓库根 —— 六个 zm_* 用户文件(配置/状态/日志)
# 固定落仓库根不进包目录,与本 gitignore 互为锚定,勿在 src/ 下另设规则
zm_debug.log
zm_crash.log
zm_stdout.log
zm_error.log
zm_state.json
# v0.4.0 本地配置/状态:zm_config.json 存 quota_api_key,提交即泄密,必加;
# zm_prices.json / zm_alerts.json 为用户本地覆盖与提醒状态,建议同加
zm_config.json
zm_prices.json
zm_alerts.json
mini_tk_events.log
# PyInstaller 打包产物
build/
dist/
*.spec
# 本地开发工具链(ZCode 迭代工作流),不属于项目本体
.zcode/
